# Configuración del Backend de La Hidrocálida
# URL base del backend (cambiar por el dominio de Railway en producción)
BACKEND_URL=http://localhost:8000

# URL del WebSocket para eventos de caja (cambiar por ws:// o wss:// según producción)
WEBSOCKET_URL=ws://localhost:8000/ws/caja

# Token de acceso JWT de un usuario con rol 'cajero' o 'administrador'
BACKEND_TOKEN=tu_token_de_acceso_aqui

# Nombre de la impresora térmica en Windows (debe coincidir exactamente con el de Panel de Control)
PRINTER_NAME=Generic / Text Only
