# Copiar a backend/.env y rellenar. Nunca comitear el .env real.

# --- Base de datos ---
# Cadena de conexión de Postgres/Neon. En docker-compose el servicio "backend"
# la sobreescribe para apuntar al Postgres local (ver docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hidrocalida

# --- Aplicación ---
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- JWT ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Orígenes exactos separados por coma. Sin wildcard, sin IPs de LAN quemadas.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Zona horaria ---
TIMEZONE=America/Mexico_City
